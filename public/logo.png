
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial,sans-serif;
}

body{
    background:#07010f;
    overflow-x:hidden;
    color:white;
    min-height:100vh;
    position:relative;
}

.bg-glow{
    position:absolute;
    border-radius:50%;
    filter:blur(120px);
    z-index:-1;
}

.glow1{
    width:400px;
    height:400px;
    background:#8b5cf6;
    top:-100px;
    left:-100px;
}

.glow2{
    width:500px;
    height:500px;
    background:#c026d3;
    right:-150px;
    bottom:-100px;
}

header{
    text-align:center;
    padding:80px 20px;
}

.logo{
    width:180px;
    margin-bottom:25px;
    filter:drop-shadow(0 0 25px #a855f7);
}

h1{
    font-size:72px;
    background:linear-gradient(90deg,#d946ef,#8b5cf6,#c084fc);
    -webkit-background-clip:text;
    -webkit-text-fill-color:transparent;
    margin-bottom:15px;
}

header p{
    color:#c4b5fd;
    margin-bottom:35px;
    font-size:20px;
}

.btn{
    display:inline-block;
    padding:15px 40px;
    border-radius:50px;
    text-decoration:none;
    color:white;
    background:linear-gradient(90deg,#7e22ce,#d946ef);
    box-shadow:0 0 25px rgba(217,70,239,0.6);
    transition:0.3s;
}

.btn:hover{
    transform:scale(1.05);
}

.features{
    display:flex;
    justify-content:center;
    flex-wrap:wrap;
    gap:30px;
    padding:50px;
}

.card{
    width:320px;
    padding:30px;
    border-radius:25px;
    background:rgba(255,255,255,0.06);
    border:1px solid rgba(255,255,255,0.1);
    backdrop-filter:blur(15px);
    transition:0.4s;
    box-shadow:0 0 30px rgba(168,85,247,0.15);
}

.card:hover{
    transform:translateY(-10px);
    box-shadow:0 0 40px rgba(217,70,239,0.35);
}

.card h2{
    margin-bottom:15px;
    color:#e879f9;
}

.card p{
    color:#d1d5db;
    line-height:1.6;
}

footer{
    text-align:center;
    padding:30px;
    color:#a78bfa;
}
